+/* Run after queued GL vertices reach Gallium, before submitting the frame fence. */
+struct switch_resolve {
+    struct pipe_context *pipe;
+    struct switch_egl_surface *surface;
+};
+
+static void
+switch_resolve_before_flush(void *data)
+{
+    struct switch_resolve *resolve = data;
+    struct switch_egl_surface *surface = resolve->surface;
+    struct pipe_blit_info blit = {0};
+    blit.src.resource = surface->color;
+    blit.dst.resource = surface->buffers[surface->cur_slot];
+    blit.src.format = blit.src.resource->format;
+    blit.dst.format = blit.dst.resource->format;
+    blit.src.box.width = blit.dst.box.width = blit.dst.resource->width0;
+    blit.src.box.height = blit.dst.box.height = blit.dst.resource->height0;
+    blit.src.box.depth = blit.dst.box.depth = 1;
+    blit.mask = PIPE_MASK_RGBA;
+    blit.filter = PIPE_TEX_FILTER_NEAREST;
+    resolve->pipe->blit(resolve->pipe, &blit);
+}
